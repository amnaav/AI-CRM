# Django settings
SECRET_KEY=django-insecure-crm-sample-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional External AI API Key (Leave blank for 100% local offline AI engines)
GEMINI_API_KEY=

# Email configuration (Console backend prints password reset links to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=aicrm-support@example.com
